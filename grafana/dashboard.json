      "targets": [
        {
          "expr": "ferry_active_slots",
          "legendFormat": "Active Local Slots",
          "refId": "A"
        }
      ],
      "title": "Active GPU Slots",
      "type": "gauge"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "ms"
        }
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "id": 4,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "expr": "ferry_last_request_duration_ms",
          "legendFormat": "Last Latency",
          "refId": "A"
        }
      ],
      "title": "Latest Turn Latency",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "id": 101,
      "title": "Throughput & Hybrid Routing Distribution",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2
          },
          "unit": "reqps"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "id": 5,
      "targets": [
        {
          "expr": "sum by (provider) (rate(ferry_requests_total{provider=~\"local|cloud\"}[1m]))",
          "legendFormat": "{{provider}}",
          "refId": "A"
        },
        {
          "expr": "sum by (type) (rate(ferry_requests_total{type=~\"spillover|failover\"}[1m]))",
          "legendFormat": "{{type}}",
          "refId": "B"
        }
      ],
      "title": "Request Throughput by Provider & Spillover",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2
          },
          "unit": "ms"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "id": 6,
      "targets": [
        {
          "expr": "rate(ferry_request_duration_ms_total{provider=\"local\"}[5m]) / rate(ferry_requests_total{provider=\"local\"}[5m])",
          "legendFormat": "Avg Local Latency (5m)",
          "refId": "A"
        },
        {
          "expr": "rate(ferry_request_duration_ms_total{provider=\"cloud\"}[5m]) / rate(ferry_requests_total{provider=\"cloud\"}[5m])",
          "legendFormat": "Avg Cloud Latency (5m)",
          "refId": "B"
        }
      ],
      "title": "Average Turn Latency (ms)",
      "type": "timeseries"
    },
    {
